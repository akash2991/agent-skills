{
  "name": "agent-brain",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "description": "Pull installer for the agent brain bundle.",
  "bin": {
    "agent-brain": "scripts/agent-brain.js"
  },
  "files": [
    "manifest.json",
    "project/AGENTS.md",
    "project/SOUL.md",
    "project/.env.example",
    "skills/**",
    "!skills/**/.terraform/**",
    "!skills/**/*.tfstate*",
    "!skills/**/terraform.tfvars",
    "agents/**",
    "references/**",
    "templates/**",
    ".claude/commands/brain*.md",
    ".gemini/commands/brain*.toml",
    "commands/brain*.toml",
    ".pi/prompts/brain*.md",
    ".codex/prompts/brain*.md",
    "scripts/agent-brain.js",
    "scripts/build-brain.js",
    "scripts/lib/build-brain.js",
    "scripts/lib/pull-install.js",
    "scripts/lib/install-paths.js",
    "scripts/lib/persona-tools.js",
    "scripts/lib/skill-lint.js",
    "scripts/lib/langfuse.js"
  ],
  "scripts": {
    "build": "node scripts/build-brain.js",
    "test:pull": "node --test scripts/agent-brain-pull-test.js scripts/langfuse-test.js",
    "test:langfuse-native": "node --test scripts/langfuse-native-test.js"
  }
}

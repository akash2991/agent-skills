# Copy to .env at the project root and fill in. .env is never committed; this file holds no secret.
# Settings with a default show it; leave them commented out to keep it.

# --- Linear (skills/linear) ---
LINEAR_TEAM=
LINEAR_API_KEY=

# --- Git workflow (skills/git-workflow-and-versioning) ---
# BRAIN_LONG_LIVED=^(staging|develop)$   # long-lived branches P16 allows besides main and release/*; also a repository variable for pr-rules.yml

# --- Mobile builds (development-setup DS16) ---
EXPO_TOKEN=                    # Expo access token: local Android builds (eas build --local) and, with explicit user permission, iOS on EAS
# EAS_FREE_BUILDS=15             # free iOS builds per month; exhausted: ask the user how to proceed
# EAS_MAX_QUEUE_MINUTES=30       # longer queue wait: cancel, then ask the user whether to retry

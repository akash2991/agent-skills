# Settings for the dev-machine scripts in infra/dev-machines/scripts. Copy to a .env the scripts can read: the
# current directory's .env, or any file named by CLOUD_ENV_FILE. Fill in from `terraform output -raw env`.
# It holds no secret; the AWS profile's credentials stay on this machine (DM6).

AWS_PROFILE=
CLOUD_REGION=ap-southeast-2     # Asia Pacific (Sydney)
CLOUD_SUBNET=                  # a subnet that assigns public addresses (outbound only), in the home volumes' zone
CLOUD_SECURITY_GROUP=          # no inbound rule; SSH runs inside Session Manager
CLOUD_INSTANCE_PROFILE=        # lets a machine's SSM agent register (brain-dev-machine)
CLOUD_KEY_NAME=                # EC2 key pair; its private key in your SSH agent
CLOUD_SCHEDULER_ROLE_ARN=      # EventBridge Scheduler role: ec2:TerminateInstances, ec2:ReleaseHosts on brain=dev
# CLOUD_HOME_VOLUME=            # your home volume, mounted as /home/ec2-user on your machine (DM9)
# CLOUD_DEFAULT_TYPE=m8i.2xlarge  # any other type needs the user's permission (DM3); x86, as Android build tools need it
# CLOUD_MAX_MACHINES=2           # live shared machines before another needs permission (DM3)
# CLOUD_IDLE_MINUTES=30          # no SSH and no load for this long: terminated (DM4)
# CLOUD_MAX_HOURS=8              # deadline after the last agent joined (DM4)
# CLOUD_DISK_GB=100
# CLOUD_AMI=                     # default: latest Amazon Linux 2023 for the type's architecture
# CLOUD_MAX_CPU_PCT=70           # headroom thresholds for joining a machine (DM2)
# CLOUD_MAX_MEM_PCT=75
# CLOUD_MAX_DISK_PCT=80
# CLOUD_MAC_AMI=                 # iOS on an AWS Mac only: macOS AMI with the pinned Xcode, Node, CocoaPods, EAS CLI (DM8)
# CLOUD_MAC_TYPE=mac2-m2.metal   # offered in ap-southeast-2a and 2b; mac2.metal is not

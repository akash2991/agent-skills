{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Skill eval artifact grading result",
  "type":"object",
  "required":["schema_version","case_id","status","quality_score","human_ratings","checks","executions","submission_sha256","fixture_sha256"],
  "properties":{
    "schema_version":{"const":1},
    "case_id":{"enum":["planning","tdd","review","debugging"]},
    "status":{"enum":["unrun","automated_checks_failed","needs_human_review","human_reviewed"]},
    "quality_score":{"type":["number","null"],"minimum":0,"maximum":100},
    "human_ratings":{"type":["array","null"],"items":{"type":"object","required":["dimension","rating","evidence","grader"],"properties":{"dimension":{"type":"string"},"rating":{"type":"integer","minimum":0,"maximum":4},"evidence":{"type":"array","minItems":1,"items":{"type":"string"}},"grader":{"type":"string"}}}},
    "checks":{"type":"array","items":{"type":"object","required":["name","passed"],"properties":{"name":{"type":"string"},"passed":{"type":"boolean"},"detail":{"type":"string"}}}},
    "executions":{"type":"array","items":{"type":"object","required":["role","command","exit_code","stdout","stderr","timeout"],"properties":{"role":{"type":"string"},"command":{"type":"array","items":{"type":"string"}},"exit_code":{"type":["integer","null"]},"stdout":{"type":"string"},"stderr":{"type":"string"},"timeout":{"type":"boolean"}}}},
    "submission_sha256":{"type":"object","additionalProperties":{"type":"string","pattern":"^[a-f0-9]{64}$"}},
    "fixture_sha256":{"type":"object","additionalProperties":{"type":"string","pattern":"^[a-f0-9]{64}$"}}
  },
  "allOf":[
    {"if":{"properties":{"status":{"const":"unrun"}}},"then":{"properties":{"quality_score":{"type":"null"},"human_ratings":{"type":"null"},"checks":{"maxItems":0},"executions":{"maxItems":0}}}},
    {"if":{"properties":{"status":{"enum":["automated_checks_failed","needs_human_review"]}}},"then":{"properties":{"quality_score":{"type":"null"},"human_ratings":{"type":"null"}}}}
  ]
}

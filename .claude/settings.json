{
  "enabledPlugins": {
    "langfuse-observability@langfuse-observability": false
  },
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/runtime/langfuse/bootstrap-claude.cjs\"", "timeout": 8 }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/runtime/langfuse/bootstrap-claude.cjs\"", "timeout": 8 }] }],
    "UserPromptExpansion": [{ "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/runtime/langfuse/bootstrap-claude.cjs\"", "timeout": 8 }] }],
    "PreToolUse": [{ "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/runtime/langfuse/bootstrap-claude.cjs\"", "timeout": 8 }] }],
    "PostToolUse": [{ "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/runtime/langfuse/bootstrap-claude.cjs\"", "timeout": 8 }] }],
    "PostToolUseFailure": [{ "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/runtime/langfuse/bootstrap-claude.cjs\"", "timeout": 8 }] }],
    "SubagentStart": [{ "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/runtime/langfuse/bootstrap-claude.cjs\"", "timeout": 8 }] }],
    "SubagentStop": [{ "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/runtime/langfuse/bootstrap-claude.cjs\"", "timeout": 8 }] }],
    "Stop": [{ "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/runtime/langfuse/bootstrap-claude.cjs\"", "timeout": 8 }] }],
    "StopFailure": [{ "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/runtime/langfuse/bootstrap-claude.cjs\"", "timeout": 8 }] }],
    "SessionEnd": [{ "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/runtime/langfuse/bootstrap-claude.cjs\"", "timeout": 10 }] }],
    "PostModelSwitch": [{ "hooks": [{ "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/runtime/langfuse/bootstrap-claude.cjs\"", "timeout": 8 }] }]
  }
}
